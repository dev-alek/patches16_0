+                             :
+      assign
+        v-nb-obj-type = entry(1, buf_doc-attr.attr-value, ";")
+        v-nb-obj-code = integer(entry(2, buf_doc-attr.attr-value, ";"))
+      no-error .                         
+    end .
+    for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = v-nb-obj-type
+                                         and buf_clients-attr.obj-code  = v-nb-obj-code
+                                         and buf_clients-attr.attr-code = {&attr-owner-code}
+                                         :
+      if (buf_clients-attr.attr-value = {&cmp} + string(bf_trn-doc.host-code)) then enable-cb-sealing = true .
+    end .
+    
+    for first buf_doc-attr where buf_doc-attr.doc-code  = bf_trn-doc.doc-code
+                             and buf_doc-attr.attr-code = {&trdcattr-autoent}
+                             :
+      assign
+        v-ae-obj-type = entry(1, buf_doc-attr.attr-value, ";")
+        v-ae-obj-code = integer(entry(2, buf_doc-attr.attr-value, ";"))
+      no-error .                         
+    end .
+    for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = v-ae-obj-type
+                                         and buf_clients-attr.obj-code  = v-ae-obj-code
+                                         and buf_clients-attr.attr-code = {&attr-have-SEP}
+                                         :
+      if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then enable-cb-sealing = true .
+    end .
+    if enable-cb-sealing
+    then do :
+      find first buf_doc-attr no-lock 
+        where buf_doc-attr.doc-code = pardoc-code 
+          and buf_doc-attr.attr-code = {&trdcattr-sealed} no-error. 
+      
+      if not available (buf_doc-attr) or (available (buf_doc-attr) and 
+        (buf_doc-attr.attr-value = "" 
+        or buf_doc-attr.attr-value = "" or buf_doc-attr.attr-value = ? or buf_doc-attr.attr-value = "?" or buf_doc-attr.attr-value = "-1")
+        )
+      then do:
+        v-error-attr = v-error-attr + ", sealing".
+      end.
+    end .
+    
     if v-error-attr <> "" then do:
       run waitfram-hide in this-procedure no-error.
       undo, return error "Не все обязательные поля по доп. информации накладной заполнены".
