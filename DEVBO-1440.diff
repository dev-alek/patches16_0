+
+
+DROP INDEX "pi" ON "doc-line"
+
+ADD INDEX "pi" ON "doc-line"
+  AREA "Doc_Index"
+  UNIQUE
+  PRIMARY
+  INDEX-FIELD "doc-code" ASCENDING
+  INDEX-FIELD "artic" ASCENDING
+  INDEX-FIELD "prod-code" ASCENDING
+  INDEX-FIELD "prod-type" ASCENDING
+  INDEX-FIELD "line-num" ASCENDING
+
+
+ADD FIELD "line-num" OF "gds-dtl" AS integer
+  FORMAT "->,>>>,>>9"
+  POSITION 28
+  INITIAL "0"
+  LABEL "Номер строки"
+  ORDER 330
+  MAX-WIDTH 4
+
+DROP INDEX "pi" ON "gds-dtl"
+
+ADD INDEX "pi" ON "gds-dtl"
+  AREA "Doc_Index"
+  UNIQUE
+  PRIMARY
+  INDEX-FIELD "doc-code" ASCENDING
+  INDEX-FIELD "artic" ASCENDING
+  INDEX-FIELD "prod-code" ASCENDING
+  INDEX-FIELD "prod-type" ASCENDING
+  INDEX-FIELD "prt-code" ASCENDING
+  INDEX-FIELD "line-num" ASCENDING
+
+.
+PSC
+cpstream=1251
+.
+0000001444
