diff --git a/ibs/th/bge/disp/dispsetting.cls b/ibs/th/bge/disp/dispsetting.cls
new file mode 100644
--- /dev/null
+++ b/ibs/th/bge/disp/dispsetting.cls
@@ -0,0 +1,74 @@
+ 
+/*
+  $Revision:$
+  $Author:$
+  $Date:$
+  $Workfile:$
+  $Archive:$
+  
+  Автор: Рубан Дмитрий Андреевич 
+  Дата создания: 9 янв. 2023 г.
+  Author:  Ruban Dmitriy Andreevich
+  Creation date: 9 янв. 2023 г.
+  
+  */
+
+using Progress.Lang.*.
+
+class ibs.th.bge.disp.dispsetting inherits   ibs.th.gbl.sys.objth :
+   define override public property vss-revision    as character no-undo init "$Revision:$":U get .
+   define override public property vss-author      as character no-undo init "$Author:$":U get.
+   define override public property vss-date        as character no-undo init "$Date:$":U get.
+   define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
+   define override public property vss-archive     as character no-undo init "$Archive:$":U get.
+   define override public property vss-description as character no-undo init "Настройки разработчиков" get.
+    
+    
+   { cmp/str-glbl.i class }  
+   { GBL/xmldom.i   class }
+   { cmp/library.i class }
+   define public property LoginAuth as character no-undo 
+   get.
+   private set.
+    
+   define public property PswdAuth as character no-undo 
+   get.
+   private set.
+   
+   define public property hostdisp as character no-undo 
+   get.
+   private set.
+   
+   define public property PortDisp as int no-undo init 8092 
+   get.
+   private set.
+   
+   
+   constructor public dispsetting ():
+      define variable vFilesetting as character no-undo.
+      define variable vFound as logical no-undo.
+      define variable vText as character no-undo.
+       
+      vFilesetting = SearchFile("bge/dispsetting.xml").
+      if      vFileSetting ne ?
+      then do:
+         
+         xmldom-load(vFileSetting).
+         xmldom-read-unique("disp","PswdAuth",output PswdAuth, output vFound).
+         xmldom-read-unique("disp","LoginAuth",output LoginAuth, output vFound).
+         xmldom-read-unique("disp","host",output hostdisp, output vFound).
+         if hostdisp eq ""
+            or hostdisp eq ?
+         then hostdisp = "127.0.0.1".
+         xmldom-read-unique("disp","port",output vtext, output vFound).
+         if    vtext ne ""
+            and vtext ne ?
+         then
+            portDisp = int(vText) no-error.
+         
+      end.
+   end constructor.
+  
+    
+    { utl/search.i class }
+end class.
\ No newline at end of file
diff --git a/ibs/th/str/CloseAndOpenShift.cls b/ibs/th/str/CloseAndOpenShift.cls
--- a/ibs/th/str/CloseAndOpenShift.cls
+++ b/ibs/th/str/CloseAndOpenShift.cls
@@ -435,4 +435,46 @@ class ibs.th.str.CloseAndOpenShift:
       end.
       return oOk.
    end.
+   method public datetime format_datetime (
+    input v-date as date,
+    input v-time as integer
+    ):
+    return datetime(
+    month(v-date),
+    day(v-date),
+    year(v-date),
+    int(entry(1,string(v-time, "HH:MM:SS:000"),":")),
+    int(entry(2,string(v-time, "HH:MM:SS:000"),":")),
+    int(entry(3,string(v-time, "HH:MM:SS:000"),":"))).
+   end.
+   
+   method public ibs.th.bge.disp.dispstatus getStatusObj():
+      def var oobj as class ibs.th.bge.disp.dispstatus no-undo.
+      oobj = new ibs.th.bge.disp.dispstatus().
+      for each clients where clients.db-num   eq g#dbnum
+                         and clients.obj-type eq {&shop}
+                         and clients.stts     eq 0
+      no-lock:
+         find last shift-obj where shift-obj.obj-type eq clients.obj-type
+                               and shift-obj.obj-code eq clients.obj-code
+                               and shift-obj.status_  eq {&sht-current}
+         no-lock no-error.
+         if avail shift-obj
+         then do:
+            oobj:shiftutc = format_datetime(shift-obj.open-date,shift-obj.open-time).
+            oobj:shiftNumber = shift-obj.shift-name.
+            oobj:order       = shift-obj.shift-num.
+            return oobj.
+         end.
+     end.
+     return oobj.
+  end.
+  def var dispSetting as ibs.th.bge.disp.dispsetting no-undo.
+   method public ibs.th.bge.disp.dispsetting getDispSet():
+      if not VALID-OBJECT (dispSetting)
+      then
+         dispSetting = new ibs.th.bge.disp.dispSetting().
+      
+      return dispSetting.
+  end. 
 end class.
