+  Author:  Ruban Dmitriy Andreevich
+  Creation date: 9 янв. 2023 г.
+  
+  */
+
+USING Progress.Lang.*.
+
+CLASS ibs.th.bge.disp.dispstatus INHERITS   ibs.th.gbl.sys.objth :
+   DEFINE OVERRIDE PUBLIC PROPERTY vss-revision    AS CHARACTER NO-UNDO INIT "$Revision:$":U GET .
+   DEFINE OVERRIDE PUBLIC PROPERTY vss-author      AS CHARACTER NO-UNDO INIT "$Author:$":U GET.
+   DEFINE OVERRIDE PUBLIC PROPERTY vss-date        AS CHARACTER NO-UNDO INIT "$Date:$":U GET.
+   DEFINE OVERRIDE PUBLIC PROPERTY vss-workfile    AS CHARACTER NO-UNDO INIT "$Workfile:$":U GET.
+   DEFINE OVERRIDE PUBLIC PROPERTY vss-archive     AS CHARACTER NO-UNDO INIT "$Archive:$":U GET.
+   DEFINE OVERRIDE PUBLIC PROPERTY vss-description AS CHARACTER NO-UNDO INIT "Статус для диспектчерской" GET.
+    
+    
+   DEFINE PUBLIC PROPERTY pMessage AS CHARACTER NO-UNDO 
+   GET.
+   SET.
+    
+   DEFINE PUBLIC PROPERTY shiftUTC AS DATETIME NO-UNDO 
+   GET.
+   SET.
+   
+   DEFINE PUBLIC PROPERTY shiftNumber AS CHARACTER NO-UNDO 
+   GET.
+   SET.
+   
+   DEFINE PUBLIC PROPERTY Order AS INT NO-UNDO 
+   GET.
+   SET.
+
+
+
+   DEFINE PUBLIC PROPERTY isError AS LOGICAL NO-UNDO 
+   GET.
+   SET.
+   
+   method public longchar getjson():
+       DEFINE VARIABLE mesjson AS LOngchar NO-UNDO.
+       mesjson = SUBSTITUTE ('~{"message":"&1","shiftUTC":"&2","shiftNuber":&3,"order":&4,"isError":&5}',
+       pMessage,
+       shiftUTC,
+       shiftNumber,
+       Order,
+       isError).
+       return mesjson.  
+   end.
+   
+END CLASS.
