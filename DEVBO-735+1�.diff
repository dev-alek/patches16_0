         when "business-unit" then do:
           GetChildrenSub (hNoderef, (level + 1), businessUnitsSubjectObj).
diff --git a/ibs/th/bge/1crn/subjects/settings.cls b/ibs/th/bge/1crn/subjects/settings.cls
