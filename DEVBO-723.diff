diff --git a/cmp/26052001.df b/cmp/26052001.df
new file mode 100644
--- /dev/null
+++ b/cmp/26052001.df
@@ -0,0 +1,69 @@
+ADD FIELD "CashShiftDate" OF "chk-slip-head" AS date
+  FORMAT "99/99/99"
+  POSITION 15
+  INITIAL ?
+  LABEL "Дата смены"
+  COLUMN-LABEL "Дата смены"
+  ORDER 120
+  MAX-WIDTH 4
+
+ADD FIELD "CashShiftNum" OF "chk-slip-head" AS integer
+  FORMAT ">>>>9"
+  POSITION 16
+  INITIAL "0"
+  LABEL "Номер смены"
+  COLUMN-LABEL "Номер смены"
+  ORDER 130
+  MAX-WIDTH 4
+
+ADD INDEX "CashShift" ON "chk-slip-head"
+  AREA "Cheque_Index"
+  INDEX-FIELD "db-num" ASCENDING
+  INDEX-FIELD "obj-code" ASCENDING
+  INDEX-FIELD "cash-num" ASCENDING
+  INDEX-FIELD "CashShiftDate" ASCENDING
+  INDEX-FIELD "CashShiftNum" ASCENDING
+
+ADD FIELD "type" OF "chk-slip-string" AS integer
+  DESCRIPTION """1 - текст, 2 - json"""
+  FORMAT ">>9"
+  POSITION 8
+  INITIAL "0"
+  LABEL "Тип"
+  COLUMN-LABEL "Тип"
+  ORDER 70
+  MAX-WIDTH 4
+
+RENAME INDEX "pi" TO "temp-45781" ON "chk-slip-string"
+
+RENAME INDEX "slip" TO "temp-45432" ON "chk-slip-string"
+
+ADD INDEX "pi" ON "chk-slip-string"
+  AREA "Cheque_Index"
+  UNIQUE
+  PRIMARY
+  INDEX-FIELD "ID" ASCENDING
+  INDEX-FIELD "CheckID" ASCENDING
+  INDEX-FIELD "RRN" ASCENDING
+  INDEX-FIELD "str-num" ASCENDING
+  INDEX-FIELD "db-num" ASCENDING
+  INDEX-FIELD "type" ASCENDING
+
+ADD INDEX "slip" ON "chk-slip-string"
+  AREA "Cheque_Index"
+  INDEX-FIELD "ID" ASCENDING
+  INDEX-FIELD "CheckID" ASCENDING
+  INDEX-FIELD "RRN" ASCENDING
+  INDEX-FIELD "db-num" ASCENDING
+  INDEX-FIELD "type" ASCENDING
+
+UPDATE PRIMARY INDEX "pi" ON "chk-slip-string"
+
+DROP INDEX "temp-45781" ON "chk-slip-string"
+DROP INDEX "temp-45432" ON "chk-slip-string"
+
+.
+PSC
+cpstream=1251
+.
+0000004818
