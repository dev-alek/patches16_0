diff --git a/example/transFile.p b/example/transFile.p
new file mode 100644
--- /dev/null
+++ b/example/transFile.p
@@ -0,0 +1,78 @@
+&glob workDir c:\work16_0
+&glob fileConvert "c:\11\file.txt"
+&glob fileResult "c:\11\res.txt"
+define variable mFileHelper as class ibs.th.file.filehelper no-undo.
+mFileHelper = new ibs.th.file.filehelper ().
+{gbl/Waitfram.i}
+{utl/ttfileList.i  ttfile  }
+run waitfram-show ("Собираем список файлов для конвертации.").
+
+mFileHelper:getListfile("{&workDir}", "*", output table ttfile).
+mFileHelper:cleartt().
+mFileHelper:addDir("{&workDir}" + "\ccf\img" ).
+mFileHelper:addDir("{&workDir}" + "\upd\code" ).
+mFileHelper:addDir("{&workDir}" + "\upd\df" ).
+mFileHelper:addDir("{&workDir}" + "\utlcomp\md5" ).
+output to {&fileConvert}.
+block-file:
+for each ttfile:
+   if    ttfile.localPach begins "cmp"
+      or ttfile.localPach begins "upd"
+   then do:
+      define variable vnewFile as character no-undo.
+      if entry(2,ttfile.fulllocalpach,".") eq "bmp"
+         or entry(2,ttfile.fulllocalpach,".") eq "ico"
+         or entry(2,ttfile.fulllocalpach,".") eq "msd"
+         or entry(2,ttfile.fulllocalpach,".") eq "jpg"
+         or (     num-entries (ttfile.fulllocalpach,".") >2 
+              and entry(3,ttfile.fulllocalpach,".") eq "bmp")
+      then
+         vnewFile = replace(ttfile.fulllocalpach,"cmp\","ccf/img/").
+      else if    entry(2,ttfile.fulllocalpach,".") eq "i"
+              or entry(2,ttfile.fulllocalpach,".") eq "p"
+              or entry(2,ttfile.fulllocalpach,".") eq "w"
+              or entry(2,ttfile.fulllocalpach,"\") eq "actn.txt"
+              or entry(2,ttfile.fulllocalpach,"\") eq "menu.txt"
+              or ttfile.fulllocalpach begins "cmp\icon\"
+      then
+        next block-file.
+      else if    entry(2,ttfile.fulllocalpach,".") eq "xml"
+      then do:
+         vnewFile = replace(ttfile.fulllocalpach,"upd\","upd/code/").
+         vnewFile = replace(vnewFile,"cmp\","ccf/").
+      end.
+      else if    entry(2,ttfile.fulllocalpach,".") eq "md5"
+      then do:
+         vnewFile = replace(ttfile.fulllocalpach,"upd\","upd/code/").
+         vnewFile = replace(vnewFile,"cmp\","utlcomp/md5/").
+      end.
+      else if    entry(2,ttfile.fulllocalpach,".") eq "df"
+      then
+         vnewFile = replace(ttfile.fulllocalpach,"cmp\","upd/df/").
+      else
+         vnewFile = replace(ttfile.fulllocalpach,"cmp\","ccf/").
+      
+      put unformatted ttfile.fulllocalpach " " vnewFile skip.
+   end.
+end. 
+output close.
+
+
+
+run waitfram-show ("Читаем сиски файлоз для переноса и текст для замены.").
+
+
+mFileHelper:addFileCopyForDir({&fileConvert},"{&workDir}").
+mFileHelper:addTextRepl({&fileConvert}).
+run waitfram-show ("Заменяем текст в файлах.").
+output to {&fileResult}.
+mFileHelper:fileRepText("{&workDir},{&workDir}\.hg\patches").
+mFileHelper:Copyfiles(yes).
+
+output close.
+
+delete object mFileHelper.
+os-command no-wait value(search({&fileResult})).
+run waitfram-hide.
+message "ok"
+view-as alert-box.
\ No newline at end of file
