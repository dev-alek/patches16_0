+   method public propmap getDevice (idb-num   as integer,
+                                    iObjCode as integer,
+                                    iPostType as character,
+                                    iCashNum  as integer      
+   ):
+      
+   define variable v-attr-value as character no-undo .
+   define variable v-attr-type  as character no-undo .
+   define variable v-device-kind as integer no-undo.
+   define variable v-date as date no-undo.
+   define variable v-decimal as decimal no-undo.
+   define variable v-logical as logical no-undo.
+   define variable v-dop as character no-undo.
+   run cd-attr-value in g#attr-lib
+      ( input idb-num
+       ,input iObjCode
+       ,input iPostType
+       ,input iCashNum
+       ,input  (if iPostType = {&cd-type-ibm-xml}
+                then {&cda-IBM-XML_operative}
+                else {&cda-AUTOTANK_operative})
+       ,input  (if iPostType = {&cd-type-ibm-xml}
+                then {&cda-IBM-XML_operative_device-kind}
+                else {&cda-AUTOTANK_operative_device-kind})
+       ,output v-attr-value
+       ,output v-date
+       ,output v-decimal
+       ,output v-device-kind
+       ,output v-logical
+       ,output v-dop
+       ) no-error.
+   if v-device-kind = ?
+   then v-device-kind = 0.
+   
+   return mdevice:GetProp(v-device-kind).
+end.
