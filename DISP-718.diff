+   method public logical openShift(icashier as int, iShiftNum as character , rid-list as character ):
+      define variable v-command as character no-undo.
+      if icashier = ? or icashier <= 0
+      then do :
+         putmes( "Сначала выберите кассира" ) .
+         return no.
+      end.
+      if iShiftNum eq ? or trim(iShiftNum) eq  ""
+      then do :
+         putmes( "Смена не должна быть пустой" ) .
+         return no.
+      end.
+      else if iShiftNum ne  "#NextShift#"
+      then do:
+         iShiftNum = trim(iShiftNum).
+         define variable vShiftNum as integer no-undo.
+         vShiftNum = integer (iShiftNum) no-error.
+         if error-status:error
+         then do:
+            putmes( "Смена не должна быть пустой" ) .
+            return no.
+         end.
+         else if vShiftNum <= 0
+         then do:
+            putmes( "Смена не должна быть больше нуля" ) .
+            return no.
+         end.
+            
+      end.
+      else do:
+         v-command = "updCommand#".
+      end.
+      
+      v-command = v-command + substitute({&xml-cmd-open-shift}, icashier, iShiftNum). 
+      sendTsoCommand(v-command,?,?, no).
+      return yes.
+   end.
