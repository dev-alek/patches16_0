+   define variable mObjType as character no-undo init {&shop}.
+   define variable mObjCode as integer no-undo.
+   method public void sendTsoCommand(icommand as character ,imethod as character, rid-list as character, iSendRun as logical ):
+      define variable ii as integer no-undo.
+      define buffer tt-tso for tt-tso.
+      define variable vSocet as handle no-undo.
+      define variable vWiatresp as logical   no-undo.
+      define variable v-command as character no-undo.
+      vWiatresp = imethod ne "" and imethod ne ?.
+      if trim(rid-list) > ""
+      then do :
+         block-tso-rec:
+         do ii = 1 to num-entries(rid-list) :
+            find first tt-tso no-lock where recid(tt-tso) = integer( entry( ii, rid-list ) ) .
+            if    (    not iSendRun
+                    and  (   tt-tso.ShiftState = mShiftState:Running :NameProp 
+                          or tt-tso.ShiftState = mShiftState:ok      :NameProp )
+                  )
+               or tt-tso.ShiftState = mShiftState:DontWork:NameProp 
+            then 
+               next block-tso-rec.
+            mObjCode = tt-tso.obj-code.
+            if icommand begins "updCommand#"
+            then
+               v-command = UpdCommand(substring (icommand,12)).
+            else
+               v-command = icommand.
+            vSocet = addSocet(tt-tso.obj-code, tt-tso.tso-num,imethod).
+            if valid-handle (vSocet)
+            then do:
+               SendRec(
+                    vSocet,
+                    tt-tso.tso-host,
+                    tt-tso.tso-port,
+                    v-command,
+                    substitute ("Отправка команды на ТСО/заправщике &1. ",tt-tso.tso-addr),
+                    vWiatresp
+                    ).
+               putLogCommand(substitute ("Отправка команды на ТСО/заправщике &1: &2&3",tt-tso.tso-addr,{&new-line},v-command)).
+            end.
+         end.      
+      end.
+      else do :
+         block-tso:
+         for each tt-tso no-lock :
+            if     (    not iSendRun
+                    and  (   tt-tso.ShiftState = mShiftState:Running :NameProp 
+                          or tt-tso.ShiftState = mShiftState:ok      :NameProp )
+                  )
+               or tt-tso.ShiftState = mShiftState:DontWork:NameProp 
+            then 
+               next block-tso.
+            mObjCode = tt-tso.obj-code.
+            if icommand begins "updCommand#"
+            then
+               v-command = UpdCommand(substring (icommand,12)).
+            else
+               v-command = icommand.
+            
+            vSocet = addSocet(tt-tso.obj-code, tt-tso.tso-num,imethod).
+            if valid-handle (vSocet)
+            then do:
+               SendRec(
+                    vSocet,
+                    tt-tso.tso-host,
+                    tt-tso.tso-port,
+                    v-command,
+                    substitute ("Отправка команды на ТСО/заправщике &1. ",tt-tso.tso-addr),
+                    vWiatresp
+                    ).
+               putLogCommand(substitute ("Отправка команды на ТСО/заправщике &1: &2&3",tt-tso.tso-addr,{&new-line},v-command)).
+            end.
+         end.
+      end.
+   end.
