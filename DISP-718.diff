diff --git a/ibs/th/bge/aazs/import/salemake2.p b/ibs/th/bge/aazs/import/salemake2.p
new file mode 100644
--- /dev/null
+++ b/ibs/th/bge/aazs/import/salemake2.p
@@ -0,0 +1,343 @@
+/*
+
+$Revision$
+$Author$
+$Date$
+$Workfile$
+$Archive$
+
+Создание продаж по шаблонам при работе по расписанию
+
+Автор: Бахтадзе Наталья Викторовна
+Дата создания: 03/24/05
+Author: Bakhtadze Natalya
+Creation date: 03/24/05
+
+*/
+
+define input parameter parparentproc as widget-handle no-undo .
+define input parameter p-parent-handle  as widget-handle no-undo .
+define input parameter p-log-handle  as handle no-undo .
+define input parameter p-parameter   as character no-undo .
+/*
+p-parameter включает
+define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
+define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
+define input parameter p-task-num    like ub.schedule.task-num no-undo .
+*/
+
+define variable p-curr-obj-type    like ub.clients.obj-type no-undo .
+define variable p-curr-obj-code    like ub.clients.obj-code no-undo .
+define variable p-cre-db-num       like ub.schedule.cre-db-num no-undo .
+define variable p-task-type        like ub.schedule.task-type no-undo .
+define variable p-task-num         like ub.schedule.task-num no-undo .
+
+
+define variable vss-revision    as character no-undo init "$Revision$":U .
+define variable vss-author      as character no-undo init "$Author$":U .
+define variable vss-date        as character no-undo init "$Date$":U .
+define variable vss-workfile    as character no-undo init "$Workfile$":U .
+define variable vss-archive     as character no-undo init "$Archive$":U .
+define variable vss-description as character no-undo init "".
+{ cmp/vssrevis.i "substitute('&1|&2|&3|&4':u,p-curr-obj-type,p-curr-obj-code,p-cre-db-num,p-task-type,p-task-num)" }
+{ cmp/trg-def.i  }
+{ str/trdcalib.i }
+{ ref/shd-attr.i }
+{ gbl/cur-time.i }
+{ cmp/strcodec.i }
+{ str/lib-trn.i  }
+{ str/doc-code.i }
+{ str/cre-sale.i }
+
+define variable v-input-error as logical no-undo .
+define variable v-view-log as logical no-undo .
+define variable v-esm as character no-undo .
+define variable log-file-name as character no-undo init 'ext-sale.log'.
+
+define shared temp-table temp-inkas no-undo like ub.inkas.
+
+&scop display-message   run write-log-and-file in p-log-handle (                             ~
+                                                                  input 1                    ~
+                                                                , input log-file-name        ~
+                                                                , input 1                    ~
+                                                                , input ~{&my-message~})
+
+
+if num-entries(p-parameter, {&delim-par}) <> 5
+then do:
+  assign
+  v-input-error = yes
+  v-esm         = substitute("Неверное количество ENTRY в составном параметре - &1, должно быть 5"
+                             , num-entries(p-parameter, {&delim-par})).
+  .
+end.
+else do:
+  assign
+  p-curr-obj-type = entry(1, p-parameter, {&delim-par})
+  p-curr-obj-code = integer(entry(2, p-parameter, {&delim-par}))
+  p-cre-db-num    = integer(entry(3, p-parameter, {&delim-par}))
+  p-task-type     = entry(4, p-parameter, {&delim-par})
+  p-task-num      = integer(entry(5, p-parameter, {&delim-par}))
+  no-error .
+  if error-status:error then do:
+    assign
+    v-esm = error-status:get-message(1)
+    v-input-error = yes
+    .
+  end.
+end.
+
+if v-input-error = yes then do:
+  run write-log-and-file in p-log-handle (
+        input 1
+      , input log-file-name
+      , input 1
+      , input substitute("Ошибка входных параметров &1:&2&3&4"
+                         , p-parameter
+                         , {&new-line}
+                         , v-esm
+                         , return-value
+                         )).
+  assign
+  v-view-log = yes.
+  return.
+end.
+
+run proc-main in this-procedure no-error .
+if error-status:error then do:
+  run write-log-and-file in p-log-handle (
+        input 1
+      , input log-file-name
+      , input 1
+      , input substitute("Ошибка при создании продаж по шаблонам - задача &1 &2&3:&4&5 &6"
+                         , p-task-num
+                         ,  p-curr-obj-type
+                         ,  p-curr-obj-code
+                         , {&new-line}
+                         , error-status:get-message(1)
+                         , return-value
+                         )).
+  assign
+  v-view-log = yes.
+  {&view-log}.
+  return "error":U.
+end.
+
+
+procedure proc-main :
+define variable v-shift-date-str as character no-undo.
+define variable v-shift-date-str-rus as character no-undo.
+define variable v-shift-date     as date no-undo .
+define variable v-shift-num      as integer no-undo.
+define variable v-filter-str     as character no-undo .
+define variable v-filter-str-rus as character no-undo .
+define variable v-filter-name    as character no-undo .
+define variable v-create         as logical no-undo .
+DEFINE VARIABLE v-time           as integer no-undo .
+define variable v-dop            as character no-undo .
+define variable v-dop1           as character no-undo .
+define variable v-dop2           as character no-undo .
+define variable v-dop3           as character no-undo .
+define variable v-dop-int        as integer   no-undo .
+define variable v-today          as date      no-undo .
+define variable v-filter-on      as logical no-undo .
+define variable cas-shft         as logical no-undo .
+define variable conf-attr        as character no-undo.                  /* для чтения параметра конфигурации */
+define variable conf-par         as character no-undo.                  /* для чтения параметра конфигурации */
+define variable par-type         as character no-undo.
+define variable v-where-phrase   as character no-undo .
+define variable v-where-phrase-rus as character no-undo .
+define variable v-rid            as recid no-undo .
+
+
+
+define buffer buf_schedule-attr for ub.schedule-attr.
+define buffer buf2_schedule-attr for ub.schedule-attr.
+define buffer buf_inkas for ub.inkas.
+define buffer buf_doc-attr for ub.doc-attr.
+
+
+  do
+  on error undo, return error return-value
+  :
+
+    run cur-time in this-procedure (output v-today, output v-time).
+    { gbl/cas-shft.i p-curr-obj-type p-curr-obj-code cas-shft }
+    /*
+    _buf_schedule-attr:
+    for each buf_schedule-attr where
+            buf_schedule-attr.cre-db-num = p-cre-db-num
+        AND buf_schedule-attr.task-type = {&btpr-type-autosale}
+        AND buf_schedule-attr.task-num = p-task-num
+        and buf_schedule-attr.attr-code begins ({&attr-schedule-date-list-h} + {&delim-par}):
+       find first buf2_schedule-attr no-lock where
+            buf2_schedule-attr.cre-db-num = p-cre-db-num
+        AND buf2_schedule-attr.task-type = {&btpr-type-autosale}
+        AND buf2_schedule-attr.task-num = p-task-num
+        and buf2_schedule-attr.attr-code =
+           ({&attr-schedule-filter-h} + {&delim-par} +
+           string(integer(entry(2, buf_schedule-attr.attr-code, {&delim-par})))
+           ) no-error.
+       assign
+       v-create = no
+       v-filter-str = "":U
+       v-filter-str-rus = "":U
+       v-where-phrase = "":U
+       v-where-phrase-rus = "":U
+       v-filter-name      = "":U
+       .
+&scop my-message substitute("!!!Ошибка при получении параметров даты и номера смены в шаблоне создания продажи:&1" + ~
+                             "&2 &3"                                                                                 ~
+                             , ~{&new-line~}                                                                         ~
+                             , error-status:get-message(1)                                                           ~
+                             , return-value )
+
+       assign
+       v-shift-date-str = entry(1, (entry(1, buf_schedule-attr.attr-value, {&delim-par})))
+       v-shift-date-str-rus = entry(1, (entry(2, buf_schedule-attr.attr-value, {&delim-par})))
+       v-shift-num      = integer(entry(2, (entry(1, buf_schedule-attr.attr-value, {&delim-par}))))
+       v-filter-name    = entry(3, buf_schedule-attr.attr-value, {&delim-par})
+       no-error .
+       if error-status:error then do:
+          assign
+          v-view-log = yes.
+         {&display-message}.
+         next _buf_schedule-attr.
+       end.
+
+      IF INDEX (v-shift-date-str, "today") = 0  THEN DO:
+        v-dop = str-decode(v-shift-date-str, "":U).
+        ASSIGN
+        v-dop = substring(v-dop, 6)
+        v-dop = TRIM(v-dop, ")")
+        v-dop1 = ENTRY(1, v-dop, {&comma-char})
+        v-dop2 = ENTRY(2, v-dop, {&comma-char})
+        v-dop3 = ENTRY(3, v-dop, {&comma-char}).
+        v-shift-date = DATE( INTEGER(v-dop1),
+                        INTEGER(v-dop2),
+                        INTEGER(v-dop3)
+                      )
+        no-error
+        .
+      END.
+      else do:
+        assign
+        v-dop = replace(v-shift-date-str, "today", "":U)
+        v-dop = replace(v-dop, "(", "":U)
+        v-dop = replace(v-dop, ")", "":U)
+        v-dop-int = integer(trim(v-dop))
+        v-shift-date = v-today + v-dop-int
+        no-error
+        .
+      end.
+      if error-status:error then do:
+        assign
+        v-view-log = yes.
+        {&display-message}.
+        next _buf_schedule-attr.
+      end.
+      if available buf2_schedule-attr then do:
+         assign
+         v-filter-str  = entry(1, buf2_schedule-attr.attr-value, {&delim-par})
+         v-filter-str-rus  = entry(2, buf2_schedule-attr.attr-value, {&delim-par})
+         .
+      end.
+      */
+      /*
+      v-create = yes.
+      _inkas:
+      for each buf_Inkas no-lock where
+                 buf_inkas.obj-type = p-curr-obj-type
+             AND buf_inkas.obj-code = p-curr-obj-code
+             and buf_inkas.shift-date = v-shift-date
+             and (cas-shft = no or buf_inkas.shift-num = v-shift-num)
+             and buf_inkas.status_ = {&g___new} :
+        if v-filter-str <> "":U then do:
+          assign
+          v-where-phrase = buf_inkas.sale-filter
+          v-where-phrase-rus = buf_Inkas.sale-filter-rus
+          .
+          if trim(v-where-phrase) = trim(v-filter-str)  then v-create = no.
+       end.
+       else do:
+          v-create = no.
+       end.
+       if v-create = no then leave _inkas.
+      end. /*for each buf_inkas*/
+      if v-create then do:
+      */
+      if not can-find (first buf_Inkas where
+                 buf_inkas.obj-type = p-curr-obj-type
+             AND buf_inkas.obj-code = p-curr-obj-code
+             and buf_inkas.shift-date = v-shift-date
+             and buf_inkas.shift-num = v-shift-num
+             and buf_inkas.status_ = {&g___new} ) then do :
+        run cre-docs in this-procedure (
+                                         input 2 /*p-auto*/
+                                        ,input p-curr-obj-type
+                                        ,input p-curr-obj-code
+                                        ,input v-shift-date
+                                        ,input (if cas-shft then v-shift-num else 0)
+                                        ,input v-filter-name
+                                        ,input v-filter-str
+                                        ,input v-filter-str-rus
+                                        ,input {&cash-desk}
+                                        ,output v-rid
+                                      ) no-error .
+        if error-status:error then do:
+&scop my-message substitute("Ошибка при создании отчета о продаже по шаблону <&1> с параметрами:&2" + ~
+                            "&3&4 дата смены &5 № смены &6&2" +                                ~
+                            "ДОП. фильтр по чекам &7:&2"                                       ~
+                            , entry(3, buf_schedule-attr.attr-value, ~{&delim-par~})           ~
+                            , ~{&new-line~}                                                    ~
+                            , p-curr-obj-type                                                  ~
+                            , p-curr-obj-code                                                  ~
+                            , v-shift-date-str-rus                                             ~
+                            , v-shift-num                                                      ~
+                            , v-filter-str-rus) +                                              ~
+                 substitute("&1 &2", error-status:get-message(1), return-value )
+          v-view-log = yes.
+/*          {&display-message}.     */
+/*          NEXT _buf_schedule-attr.*/
+        end.
+        find first buf_Inkas no-lock where
+                  recid(buf_inkas) = v-rid .
+        create temp-inkas.
+        buffer-copy buf_inkas to temp-inkas.
+&scop   my-message       substitute("Создан документ продажи &1 по шаблону <&2> с параметрами:&3" + ~
+                            "&4 дата смены &5 № смены &6&3" +                                ~
+                            "ДОП. фильтр по чекам &7&3"                                        ~
+                            , temp-inkas.inkas-code                                            ~
+                            , entry(3, buf_schedule-attr.attr-value, ~{&delim-par~})           ~
+                            , ~{&new-line~}                                                    ~
+                            , p-curr-obj-type + string(p-curr-obj-code)                        ~
+                            , v-shift-date-str-rus                                             ~
+                            , v-shift-num                                                      ~
+                            , v-filter-str-rus)
+
+/*        {&display-message}.*/
+      end.
+      else do:
+&scop my-message substitute("Не будет создан документ продажи по шаблону <&1> с параметрами:&2" + ~
+                            "&3&4 дата смены &5 № смены &6&2" +                                ~
+                            "ДОП. фильтр по чекам &7&2" +                                     ~
+                            "Уже есть документ продажи с такими параметрами"                    ~
+                            , entry(3, buf_schedule-attr.attr-value, ~{&delim-par~})           ~
+                            , ~{&new-line~}                                                    ~
+                            , p-curr-obj-type                                                  ~
+                            , p-curr-obj-code                                                  ~
+                            , v-shift-date-str-rus                                             ~
+                            , v-shift-num                                                      ~
+                            , v-filter-str-rus)
+
+        assign
+        v-view-log = yes.
+/*        {&display-message}.     */
+/*        NEXT _buf_schedule-attr.*/
+      end.
+/*      
+    end. /*for each buf_schedule-attr where*/
+*/    
+  end. /*doe*/
+
+end procedure. /* main */
\ No newline at end of file
diff --git a/ibs/th/str/CloseAndOpenShift.cls b/ibs/th/str/CloseAndOpenShift.cls
new file mode 100644
--- /dev/null
+++ b/ibs/th/str/CloseAndOpenShift.cls
@@ -0,0 +1,438 @@
+ 
+ /*------------------------------------------------------------------------
+    File        : CloseAndOpenShift
+    Purpose     : 
+    Syntax      : 
+    Description : 
+    Author(s)   : Daru
+    Created     : Sat May 13 11:46:56 MSK 2023
+    Notes       : 
+  ----------------------------------------------------------------------*/
+
+using Progress.Lang.*.
+
+block-level on error undo, throw.
+&glob TimeOutSend 30
+&glob TimeOutRvs  50
+class ibs.th.str.CloseAndOpenShift: 
+   /*------------------------------------------------------------------------------
+    Purpose:
+    Notes:
+   ------------------------------------------------------------------------------*/
+   {cmp/str-glbl.i class}
+   define variable g#dbNum as integer no-undo.
+   
+   define variable parparentproc   as handle no-undo.
+   define variable WorkHandel      as handle no-undo.
+   define variable mTso            as ibs.th.str.tso_trg no-undo.
+   define variable mShiftState     as ibs.th.str.cash.ShiftState no-undo.
+   
+   method public void putLog(istr as character ):
+      run PutMesAsunc in WorkHandel(istr).
+      
+   end.
+   
+   constructor public CloseAndOpenShift ():
+      this-object (no).
+   end.
+      
+   constructor public CloseAndOpenShift (iDebug as logical):
+      super ().
+      run ibs/th/str/closeadnopenshiftproc.p persistent set WorkHandel (iDebug) .
+      mTso        = new ibs.th.str.tso_trg(WorkHandel,yes).
+      mShiftState = new ibs.th.str.cash.ShiftState().
+      mTso:setFirstStaff().
+      run gbl/getdbnum.p (output g#dbNum).
+      parparentproc = WorkHandel.
+   end constructor.
+   
+   destructor public CloseAndOpenShift ( ):
+      delete object mShiftState.
+      delete object mTso.
+   end destructor.
+
+   /*------------------------------------------------------------------------------
+    Purpose:
+    Notes:
+   ------------------------------------------------------------------------------*/
+
+   method public logical crRvsControl():
+      run str/rvs-auto.p (WorkHandel,
+                          WorkHandel,
+                          WorkHandel,
+                          g#dbnum,
+                          ?,
+                          ?,
+                          g#dbnum) no-error.
+      putLog(return-value).
+      return not (    error-status:error
+                   or index(return-value,"ОШИБКА!") > 0).
+   end method.
+   
+   method public logical crRvsControl(iCycle as integer):
+      return cycleOperThis(iCycle,"crRvsControl").
+   end.
+   
+   method public logical crRvsShift(iCycle as integer):
+      return cycleOperThis(iCycle,"crRvsShift").
+   end.
+   
+   method public logical crRvsShift():
+      define variable vOk as logical no-undo init yes.
+      for each clients where clients.db-num   eq g#dbnum
+                         and clients.obj-type eq {&shop}
+                         and clients.stts     eq 0
+      no-lock:
+         find last shift-obj where shift-obj.obj-type eq clients.obj-type
+                               and shift-obj.obj-code eq clients.obj-code
+                               and shift-obj.status_  eq {&sht-current}
+         no-lock no-error.
+         if available shift-obj
+         then do:
+            find first rvs-doc where rvs-doc.obj-type   eq shift-obj.obj-type
+                                 and rvs-doc.obj-code   eq shift-obj.obj-code
+                                 and rvs-doc.shift-date eq shift-obj.shift-date
+                                 and rvs-doc.shift-num  eq shift-obj.shift-num
+                                 and rvs-doc.status_    eq {&fact}
+            no-lock no-error.
+            if available rvs-doc
+            then do:
+               vOk = crRvsShiftForCtrl(recid(rvs-doc)).
+               
+            end.
+            else
+               vOk = false.
+         end.
+         else
+            vOk = false.
+      end.
+      return vOk.
+   end.
+   
+   method public logical crRvsShiftForCtrl(irecidRvsControl as recid):
+      define variable v-str as character no-undo.
+      define variable jj as integer no-undo.
+      run str/ctrc2sht.p
+            ( input parparentproc
+            ,input irecidRvsControl
+            ) no-error.
+      if error-status :error
+      then do:
+         assign 
+             v-str = return-value.
+         do jj = 1 to error-status :num-messages :
+             assign 
+                 v-str = v-str + ( if v-str = "":U then "":U else {&new-line} ) + error-status :get-message( jj ).
+         end.
+         assign 
+             v-str = v-str + ( if v-str = "":U then "":U else {&new-line} ) + return-value.
+             v-str =  "Ошибка создания сверки." + {&new-line} + v-str .
+         putLog(v-str).
+         return false.
+     end.
+     return true.
+     
+   end.
+   
+   method public logical OpenShiftTh(iCycle as integer):
+      return cycleOperThis(iCycle,"OpenShiftTh").
+   end.
+   
+   method public logical OpenShiftTh():
+      define variable vOk as logical no-undo init yes.
+      for each clients where clients.db-num   eq g#dbnum
+                         and clients.obj-type eq {&shop}
+                         and clients.stts     eq 0
+      no-lock:
+         find last shift-obj where shift-obj.obj-type eq clients.obj-type
+                               and shift-obj.obj-code eq clients.obj-code
+                               and shift-obj.status_  eq {&sht-current}
+         no-lock no-error.
+         if not available shift-obj
+         then do:
+            vOk = OpenShiftTh(clients.obj-type,clients.obj-code).
+            
+         end.
+         else
+            vOk = false.
+      end.
+      return vOk.
+   end.
+   
+   method public logical OpenShiftTh(iObjType as char,iObjCode as int):
+      define variable v-str as character no-undo.
+      define variable jj as integer no-undo.
+      define variable vOK as logical no-undo.
+      run gbl/sht-open-next.p ( output vOk,
+                                input parparentproc, 
+                                input iObjType, 
+                                input iObjCode ) no-error .
+      if error-status :error
+      then do:
+         assign 
+             v-str = "":U.
+         do jj = 1 to error-status :num-messages :
+             assign 
+                 v-str = v-str + ( if v-str = "":U then "":U else {&new-line} ) + error-status :get-message( jj ).
+         end.
+         assign 
+             v-str = v-str + ( if v-str = "":U then "":U else {&new-line} ) + return-value.
+             v-str =  "Ошибка создания сверки." + {&new-line} + v-str .
+         putLog(v-str).
+         return false.
+      end.
+      if vOk
+      then
+         vOk = addStaff(iObjType,iObjCode).
+      return vOk.
+   end.
+   
+   
+   method public logical addStaff (iObjType as char,iObjCode as int):
+      define variable vOk as logical no-undo.
+      define buffer shift-obj for ub.shift-obj.
+      define buffer buf_staff for ub.staff.
+      define buffer clients   for clients.
+      define buffer buf_shift-staff for shift-staff.
+      find last shift-obj where shift-obj.obj-type eq iObjType
+                            and shift-obj.obj-code eq iObjCode
+                            and shift-obj.status_  eq {&sht-current}
+         no-lock no-error.
+      if not available shift-obj
+      then do:
+         putLog(substitute ("Нет текущей смены на объекте &1&2",iObjType,iObjCode)).
+         return false.
+      end.
+      find first buf_staff no-lock where
+                       buf_staff.psn-code = 999 no-error.
+      if not avail buf_staff then do:
+         putLog(substitute("Не найден кассир - с кодом &1", 999)).
+         find first buf_staff no-lock  no-error.
+         if not available buf_staff
+         then do:
+            putLog(substitute("Нет ниодного кассира")).
+            return false.
+         end.
+         putLog(substitute("Вместо кассира 99 взят касиср &1", buf_staff.psn-code)).
+      end.
+      find first ub.person no-lock where
+                 ub.person.psn-code  = buf_staff.psn-code no-error.
+      if not avail person then do:
+         putLog(substitute("Не найден человек - с кодом &1", buf_staff.psn-code)).
+         return false.
+      end.
+      find first clients no-lock where
+                 clients.obj-type = {&prs} and
+                 clients.obj-code = person.psn-code no-error.
+      if not avail clients then do:
+         putLog(substitute("Не найден человек - с кодом &1&2",{&prs}, person.psn-code)).
+         return false.
+      end.
+           
+      find first buf_shift-staff where
+                 buf_shift-staff.OBJ-TYPE   = iObjType 
+             and buf_shift-staff.obj-code   = iObjCode 
+             and buf_shift-staff.shift-num  = shift-obj.shift-num 
+             and buf_shift-staff.shift-date = shift-obj.shift-date 
+             and buf_shift-staff.next-shift = no 
+             and buf_shift-staff.psn-num    = person.psn-code no-error.
+
+      if not avail buf_shift-staff then do:
+         create buf_shift-staff.
+         assign
+            buf_shift-staff.obj-type   = iObjType
+            buf_shift-staff.obj-code   = iObjCode
+            buf_shift-staff.shift-num  = shift-obj.shift-num
+            buf_shift-staff.shift-name = shift-obj.shift-name
+            buf_shift-staff.shift-date = shift-obj.shift-date
+            buf_shift-staff.psn-num    = person.psn-code
+            buf_shift-staff.next-shift = no
+         .
+      end.
+      if avail buf_shift-staff then do:
+         assign
+            buf_shift-staff.NAME = clients.obj-name + {&space-char} +
+                                   person.name1 + {&space-char} + person.name2
+            buf_shift-staff.cashier = buf_staff.staff-code
+            buf_shift-staff.staff-role = yes
+         .
+     end.
+            
+     return avail buf_shift-staff.
+   end.
+   
+   method public logical crSale():
+      run str/sal-shd.p
+                  (input parparentproc
+                  ,input ?
+                  ,input ?
+                  ,input ?
+                  ,input g#dbnum
+                  ) no-error.
+       return not error-status:error.
+   end.
+   
+   method public logical crSale(iCycle as integer):
+      return cycleOperThis(iCycle,"crSale").
+   end.
+   method public logical cycleOperTso(iCycle as integer,iOperation as character, iStList as character ):
+      define variable vi as integer no-undo.
+      do vi = 1 to iCycle:
+         if vi ne 1
+         then do:
+            myPause ( {&TimeOutSend}).
+         end.
+         dynamic-invoke (mTso,iOperation).
+         myPause ( 1 ).
+         mTso:tso-send-Stat().
+         mTso:waitReadSts().
+         if mTso:AllTsoInSts(iStList)
+         then
+            return yes.
+         
+      end.
+      return no.
+   end.
+   
+   method public logical cycleOperThis(iCycle as integer,iOperation as character):
+      define variable vi as integer no-undo.
+      
+      do vi = 1 to iCycle:
+         if vi ne 1
+         then
+            myPause ({&TimeOutSend} ).
+         myPause ( 1 ).
+         
+         if dynamic-invoke (this-object,iOperation)
+         then
+            return yes.
+         
+      end.
+      return no.
+   end.
+   
+   method public logical StopShift():
+      return StopShift(1).
+   end.
+   
+   method public logical StopShift(iCycle as integer):
+      define variable vList as character no-undo.
+      vList = substitute ("&1,&2,&3",
+                          mShiftState:Stopped:NameProp,
+                          mShiftState:DontWork:NameProp,
+                          mShiftState:Closed:NameProp).
+      return cycleOperTso(iCycle,"stopShift",vList).
+   end.
+
+   method public logical cycleOneInState(iCycle as integer, iStList as character ):
+      define variable vi as integer no-undo.
+      do vi = 1 to iCycle:
+         if vi ne 1
+         then
+            myPause ({&TimeOutRvs}).
+         mTso:tso-send-Stat().
+         mTso:waitReadSts().
+         if mTso:oneTsoInSts(iStList)
+         then
+            return yes.
+         
+      end.
+      return no.
+   end.
+
+   method public logical canCloseShift(iCycle as integer):
+      define variable vList as character no-undo.
+      vList = substitute ("&1,&2,&3",mShiftState:Stopped:NameProp,
+                                     mShiftState:DontWork:NameProp,
+                                     mShiftState:Closed:NameProp).
+      return cycleOneInState(iCycle,vList).
+   end.
+   
+   method public logical CloseShift():
+      return CloseShift(1).
+   end.
+   
+   method public logical CloseShift(iCycle as integer):
+      define variable vList as character no-undo.
+      vList = substitute ("&1,&2",mShiftState:Closed:NameProp,mShiftState:DontWork:NameProp).
+      return cycleOperTso(iCycle,"CloseShift",vList).
+   end.
+   
+   method public logical openShift():
+      return openShift(1).
+   end.
+   
+   method public logical openShift(iCycle as integer):
+      define variable vList as character no-undo.
+      vList = substitute ("&1,&2,&3",mShiftState:Running:NameProp,mShiftState:DontWork:NameProp,mShiftState:Stopped:NameProp).
+      return cycleOperTso(iCycle,"openShift",vList).
+   end.
+   
+   method public logical startShift():
+      return startShift(1).
+   end.
+   
+   method public logical startShift(iCycle as integer):
+      define variable vList as character no-undo.
+      vList = substitute ("&1,&2",mShiftState:Running:NameProp,mShiftState:DontWork:NameProp).
+      return cycleOperTso(iCycle,"startShift",vList).
+   end.
+   
+   method public void myPause(iTime as decimal):
+      run gbl/pause.p( iTime * 1000).
+   end.
+   
+   method public logical getSlips(iCycle as integer):
+      return cycleOperThis(iCycle,"getSlips").
+   end.
+   
+   method public logical getSlips():
+      define variable oOk as logical no-undo init yes.
+      define variable vOk as logical no-undo init yes.
+      define buffer clients   for ub.clients.
+      for each clients where clients.db-num   eq g#dbnum
+                         and clients.obj-type eq {&shop}
+                         and clients.stts     eq 0
+      no-lock:
+         run str/get-chk-slips.p(parparentproc,
+                                 WorkHandel,
+                                 WorkHandel,
+                                 "",
+                                 clients.obj-type,
+                                 clients.obj-code,
+                                 output vOk) no-error.
+         if    error-status:error
+            or not vOk
+         then
+            oOk = false.
+      end.
+      return oOk.
+   end.
+   
+   method public logical getTranFuel(iCycle as integer):
+      return cycleOperThis(iCycle,"getTranFuel").
+   end.
+   
+   method public logical getTranFuel():
+      define variable oOk as logical no-undo init yes.
+      define variable vOk as logical no-undo init yes.
+      define buffer clients   for ub.clients.
+      for each clients where clients.db-num   eq g#dbnum
+                         and clients.obj-type eq {&shop}
+                         and clients.stts     eq 0
+      no-lock:
+         run str/get-tran-fuel.p(parparentproc,
+                                 WorkHandel,
+                                 WorkHandel,
+                                 "",
+                                 clients.obj-type,
+                                 clients.obj-code,
+                                 output vOk) no-error.
+         if    error-status:error
+            or not vOk
+         then
+            oOk = false.
+      end.
+      return oOk.
+   end.
+end class.
