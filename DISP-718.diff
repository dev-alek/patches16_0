+   method public logical waitReadSts ():
+      define variable vi as int64 no-undo.
+      do while tso-read-sts ():
+         vi = vi + 1.
+      end.
+   end.
+   
+   method public logical tso-read-sts ():
+      define buffer tt-tso-socet for tt-tso-socet.
+/*      define buffer tt-tso       for tt-tso.*/
+      define variable isRef as logical no-undo.
+      define variable vWorkSocet as logical no-undo.
+      define variable isWork as logical no-undo.
+      for each tt-tso-socet:
+         run IsWorkSocet in tt-tso-socet.tso-socet (output vWorkSocet).
+         if vWorkSocet
+         then do:
+            run WaitRespTestStop in tt-tso-socet.tso-socet.
+            run isEndWork in tt-tso-socet.tso-socet (output vWorkSocet).
+            if vWorkSocet
+            then do:
+               define variable vResult as memptr no-undo.
+               if     tt-tso-socet.tsomethodresp ne ""
+                  and tt-tso-socet.tsomethodresp ne ?
+               then do:
+                  find first tt-tso where tt-tso.obj-code eq tt-tso-socet.obj-code
+                                      and tt-tso.tso-num  eq tt-tso-socet.tso-num
+                  no-lock.
+                  tt-tso.FiscalStatus = "НЕ ОТВЕЧАЕТ" .
+                  run getResponceMemptr in tt-tso-socet.tso-socet (output vResult).
+                  if     vResult ne ?
+                  then do:
+                     define variable vreslong as longchar no-undo.
+                     copy-lob from  object vResult to vreslong.
+                     putLogCommand(substitute ("Получен ответ от ТСО/заправщике &1. &2",tt-tso.tso-addr,vreslong)).
+                     dynamic-invoke (this-object,tt-tso-socet.tsomethodresp,vResult) no-error.
+                     if error-status:error
+                     then
+                        tt-tso.FiscalStatus = "Плохой ответ" .
+                     putLog(substitute ("Статус ТСО/заправщике &4 &1: &2 &3 &5",tt-tso.tso-addr,tt-tso.FiscalStatus,tt-tso.PosStatus,tt-tso.tso-num, tt-tso.ShiftState)).
+                  end.
+                  else do:
+                     
+                  end.
+                  tt-tso-socet.tsomethodresp = "".
+                  isRef = yes.
+               end.
+            end.
+            else 
+               isWork = yes.
+         end.
+         else if     tt-tso-socet.tsomethodresp ne ""
+                 and tt-tso-socet.tsomethodresp ne ?
+         then do:
+            tt-tso-socet.tsomethodresp = "".
+            find first tt-tso where tt-tso.obj-code eq tt-tso-socet.obj-code
+                                      and tt-tso.tso-num  eq tt-tso-socet.tso-num
+                  no-lock.
+                 
+            tt-tso.FiscalStatus        = "НЕ ОТВЕЧАЕТ" .
+            isRef = yes.
+         end.
+         
+      end.
+      if isRef
+      then
+         refrash().
+      return isWork.
+   end. 
