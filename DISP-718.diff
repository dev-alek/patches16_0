+   method public void parse-xml (iMemptr as memptr):
+      define variable hDoc as handle no-undo.
+      define variable hRoot as handle no-undo.
+      create  x-document hDoc.
+      create  x-noderef  hRoot.
+     
+      hDoc:load("memptr",iMemptr,false) no-error.
+      if error-status:error
+      then do:
+         return error.
+      end.
+      hDoc:get-document-element(hRoot).
+      
+      getChildren(hRoot, 1).
+      delete object hDoc.
+      delete object hRoot.
+  
+   end .
+   define variable v-parsesub as character no-undo.
+   method public void getChildren(hParent as handle,level as integer):
+      define variable hNoderef as handle no-undo.
+      define variable hText    as handle no-undo.
+      define variable vi as integer no-undo.
+      define variable good as logical no-undo.
+      
+      create x-noderef hNoderef.
+      create x-noderef hText .
+      
+      block-pars:
+      repeat vi = 1 to hParent:num-children:
+         good = hParent:get-child(hNoderef,vi).
+         if not good 
+         then 
+            leave block-pars.
+         if hNoderef:subtype <> "element" 
+         then
+            next block-pars.
+    
+         hNoderef:get-child(hText, 1) no-error .    
+    
+        
+         if hNoderef:name = "PumpStatus"
+         then do :
+            v-parsesub = "Pump" .
+            find first tt-pump exclusive-lock where 
+                       tt-pump.pump-code = integer(hNoderef:get-attribute("num")) 
+                   and tt-pump.obj-type  = mObjType
+                   and tt-pump.obj-code  = mObjCode
+            no-error .
+         end.
+    
+         if      hNoderef:name = "PosStatus"
+         then 
+            tt-tso.PosStatus = hText:node-value no-error .
+         else if hNoderef:name = "FiscalStatus" 
+         then 
+            v-parsesub = "Fiscal" .
+         else if hNoderef:name = "ShiftState"
+         then do :
+            tt-tso.ShiftBegin = hNoderef:get-attribute("begin") no-error .
+            tt-tso.ShiftNum   = integer(hNoderef:get-attribute("num")) no-error .
+            tt-tso.ShiftState = hText:node-value no-error .
+            putLog(substitute ("Статус ТСО/заправщике tt-tso.ShiftState - &4 &3 &1: &2 ",tt-tso.tso-addr,tt-tso.ShiftState,tt-tso.tso-num,tt-tso.obj-code)).
+         end.
+         else if hNoderef:name = "StatCashier" 
+         then 
+            tt-tso.CashierNum = integer(hText:node-value) no-error .
+         else if hNoderef:name = "State"
+         then do :
+            case v-parsesub :
+               when "Pump"
+               then do :
+                  if available tt-pump
+                  then
+                     tt-pump.status_ = hText:node-value no-error .
+               end.
+               when "Fiscal"
+               then do:
+                  tt-tso.FiscalStatus = hText:node-value no-error .
+                  putLog(substitute ("Статус ТСО/заправщике fiscal - &4 &3 &1: &2 ",tt-tso.tso-addr,tt-tso.FiscalStatus,tt-tso.tso-num,tt-tso.obj-code)).
+               end.
+            end case .
+         end.
+         else if      hNoderef:name = "ErrorText"
+                  and v-parsesub = "Fiscal"
+                  and tt-tso.FiscalStatus = "Error"
+         then
+            tt-tso.FiscalStatus = hText:node-value no-error .
+         else if hNoderef:name = "LastZreportDate" 
+         then
+            tt-tso.zReportDate = hText:node-value no-error .
+         else if hNoderef:name = "QueueSize" 
+         then 
+            tt-tso.FiscalQueue = integer(hText:node-value) no-error .
+         else if     hNoderef:name = "NumTrans"
+                 and available tt-pump
+         then
+            tt-pump.numTr = integer(hText:node-value) no-error .
+         GetChildren(hNoderef, (level + 1)).
+      end.
+      delete object hNoderef.
+      delete object hText.
+   end.
