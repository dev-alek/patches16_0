diff --git a/ibs/th/str/tso_trg.cls b/ibs/th/str/tso_trg.cls
new file mode 100644
--- /dev/null
+++ b/ibs/th/str/tso_trg.cls
@@ -0,0 +1,938 @@
+ 
+ /*------------------------------------------------------------------------
+    File        : tso_trg
+    Purpose     : 
+    Syntax      : 
+    Description : 
+    Author(s)   : Daru
+    Created     : Sat May 20 10:24:32 MSK 2023
+    Notes       : 
+  ----------------------------------------------------------------------*/
+
+using Progress.Lang.*.
+
+block-level on error undo, throw.
+
+class ibs.th.str.tso_trg: 
+   /*------------------------------------------------------------------------------
+    Purpose:
+    Notes:
+   ------------------------------------------------------------------------------*/
+   define variable parparentproc as handle no-undo.
+   define variable SilentMode    as logical no-undo.
+   
+   { cmp/str-glbl.i class }
+   { ref/tso-tt.i}
+   define variable rid-list-tso as character no-undo.
+   
+   define variable g#dbNum as integer no-undo.
+   define variable mdevice        as class     ibs.th.str.cash.CashDevice
+            no-undo.
+   define variable mShiftState        as class     ibs.th.str.cash.ShiftState no-undo.
+   define variable mPumpStatus        as class     ibs.th.str.cash.PumpStatus no-undo.
+   { utl/proc-async.i proc_log parparentproc}
+   
+   method public void putLog(istr as character ):
+      PutMesAsunc (istr).
+   end.
+   
+   method public void putLogCommand(istr as character ):
+/*      putLog (istr).*/
+   end.
+   
+   method public void putMes(istr as character ):
+      if SilentMode
+      then
+         putLog (istr).
+      else
+         message istr
+            view-as alert-box.
+   end.
+   
+   constructor public tso_trg ():
+      this-object(?).
+      
+   end.
+   
+   constructor public tso_trg (input iparparentproc   as handle):
+      this-object(iparparentproc,no).
+   end.
+   
+   constructor public tso_trg (input iparparentproc   as handle,
+                               input iSilent          as logical  ):
+      super ().
+      parparentproc = iparparentproc.
+      SilentMode = iSilent.
+      run gbl/getdbnum.p (output g#dbNum).
+      
+      mdevice = new ibs.th.str.cash.CashDevice().
+      mShiftState = new ibs.th.str.cash.ShiftState().
+      mPumpStatus = new ibs.th.str.cash.PumpStatus().
+      init-tt({&all},?,?).
+   end constructor.
+
+   destructor public tso_trg ( ):
+      delete object mPumpStatus.
+      delete object mShiftState.
+      delete object mdevice.
+   end destructor.
+   
+   method public handle addSocet (iobjcode as integer, 
+                                  itsonum  as integer,
+                                  iMethod  as character  ):
+      define variable vWorkSocet as logical no-undo.
+      define variable vSocetHand as handle  no-undo.
+      define variable vNum       as integer no-undo.
+      for each tt-tso-socet where tt-tso-socet.obj-code eq iobjcode
+                              and tt-tso-socet.tso-num  eq itsonum: 
+         if not valid-handle(tt-tso-socet.tso-socet)
+         then do:
+            run bge/socet.p persistent set tt-tso-socet.tso-socet.
+            run setParam in tt-tso-socet.tso-socet ("addtimeOut","false").
+            run setParam in tt-tso-socet.tso-socet ("timeOut","5").
+         end.
+         run IsWorkSocet in tt-tso-socet.tso-socet (output vWorkSocet).
+         if not vWorkSocet
+         then do:
+            tt-tso-socet.tsomethodresp = iMethod.
+            return tt-tso-socet.tso-socet.
+         end.
+         vNum = tt-tso-socet.socet-num.
+      end.
+      vNum = vNum + 1.
+      if vNum > 1000
+      then
+         return error.
+      create tt-tso-socet.
+      assign
+         tt-tso-socet.obj-code      = iobjcode
+         tt-tso-socet.tso-num       = itsonum
+         tt-tso-socet.socet-num     = vNum
+         tt-tso-socet.tsomethodresp = iMethod
+      .
+      run bge/socet.p persistent set tt-tso-socet.tso-socet.
+      run setParam in tt-tso-socet.tso-socet ("addtimeOut","false").
+      run setParam in tt-tso-socet.tso-socet ("timeOut","5").
+      return tt-tso-socet.tso-socet.
+   end.
+   
+   method public void delSocet ():
+      for each tt-tso-socet : 
+         if valid-handle(tt-tso-socet.tso-socet)
+         then do:
+            def var libobjhndl as handle no-undo.
+            libobjhndl = tt-tso-socet.tso-socet.
+            apply 'delete' to libobjhndl.
+            delete procedure libobjhndl.
+         end.
+      end.
+   end.
+   
+   &scop xml-cmd-stat '<?xml version="1.0" encoding="UTF-8"?>~
+<control type="REQUEST">~
+  <Status ctrl="READ">~
+    <PumpStatus></PumpStatus>~
+    <PosStatus></PosStatus>~
+    <FiscalStatus></FiscalStatus>~
+    <ShiftStatus></ShiftStatus>~
+    <StatCashier></StatCashier>~
+  </Status>~
+</control>'
+
+&scop xml-cmd-open-shift '<?xml version="1.0" encoding="UTF-8"?>~
+<control type="REQUEST">~
+  <Command ctrl="ADD">~
+    <CommType>tsoOperate</CommType>~
+    <CommValue>shift_open</CommValue>~
+    <CashierCode>&1</CashierCode>~
