+                                            and buf_cash-desk-attr.attr-code = "device-kind"
+                                            and buf_cash-desk-attr.attr-value-integer = mdevice:Tanker:KeyInt)  :
+               find first buf_cash-desk no-lock where buf_cash-desk.db-num   = buf_cash-desk-attr.db-num
+                                           and buf_cash-desk.obj-code = buf_cash-desk-attr.obj-code
+                                           and buf_cash-desk.pos-type = buf_cash-desk-attr.pos-type
+                                           and buf_cash-desk.cash-num = buf_cash-desk-attr.cash-num
+                                           and buf_cash-desk.is-del   = no 
+                                           no-error .
+               if available buf_cash-desk
+               then do :
+                  create tt-tso.
+                  assign
+                     tt-tso.db-num       = buf_cash-desk.db-num
+                     tt-tso.obj-code     = buf_cash-desk.obj-code
+                     tt-tso.tso-num      = buf_cash-desk.cash-num
+                     tt-tso.tso-addr     = replace(buf_cash-desk.addr-path, {&delim-par}, '://')
+                     tt-tso.tso-addr     = entry(1,entry(2,buf_cash-desk.addr-path, {&delim-par}),":")
+                     tt-tso.tso-port     = int(entry(2,entry(2,buf_cash-desk.addr-path, {&delim-par}),":"))
+                     tt-tso.Tso-protocol = entry(1,buf_cash-desk.addr-path, {&delim-par})
+                  .
+                  if not buf_cash-desk.cash-on
+                  then
+                     tt-tso.ShiftState      = mShiftState:DontWork:NameProp.
+               end.                                                           
+            end.  
+            for each buf_clients no-lock where buf_clients.db-num = g#dbNum :
+               for each buf_pump no-lock where buf_pump.obj-type = buf_clients.obj-type
+                                           and buf_pump.obj-code = buf_clients.obj-code :
+                  create tt-pump .
+                  assign
+                     tt-pump.pump-code = buf_pump.pump-code
+                     tt-pump.obj-type  = buf_pump.obj-type
+                     tt-pump.obj-code  = buf_pump.obj-code
+                  .
+               end.
+            end.                                      
+         end.
+      end case.
+   end.
+   
+   method public handle getQuery (input iNameQuery as character ) :
+        return getQuery(iNameQuery,no).
+   end.
+    define temp-table tt-query no-undo
+      field NameQuery as character 
+      field hQuery    as handle
+  index NameQuery NameQuery.
+  
+   method public handle getQuery (input iNameQuery as character,input iNewQuery as logical ) :
+      define variable hQuery   as handle  no-undo .
+      define variable vfirst   as logical no-undo init yes.
+      define variable vOpen    as logical no-undo init yes.
+      define variable vTblName as character no-undo .
+      define variable vOpenStr as character no-undo .
+    
+      find first tt-Query where tt-Query.NameQuery eq iNameQuery
+        no-error.
+      if     available tt-Query
+         and iNewQuery
+      then do:
+         delete object tt-Query.hQuery.
+         delete tt-Query.
+      end.      
+      if not available tt-Query
+      then 
+      do: 
+          create query hQuery.
+      end.
+      else
+         hQuery = tt-Query.hQuery.
+          
+          case iNameQuery:
+              when "tso"
+              then do:
+                  hQuery:set-buffers(buffer tt-tso:HANDLE). 
+                  hQuery:query-prepare("FOR EACH tt-tso by tt-tso.ShiftState"). 
+              end.
+             
+              when "pump"
+              then do:
+                 hQuery:set-buffers(buffer tt-pump:HANDLE). 
+                 hQuery:query-prepare("FOR EACH tt-pump ").
+              end.                   
+          end case.
+          if vOpen
+          then do:
+             hQuery:query-open.
+
+             if vFirst 
+             then
+                 hQuery:get-first () no-error .
+          end.
+              
+          if not available tt-Query
+          then 
+          do: 
+             create tt-Query.
+          
+          assign
+              tt-Query.NameQuery = iNameQuery
+              
+              tt-Query.hQuery    = hQuery
+          .         
+      end.
+      return hQuery.
+    end.
+   
+   method public void setTable(input iHandleSet as handle):
+      run settabletso  in iHandleSet (input table tt-tso).
+      run setTablePump in iHandleSet (input table tt-pump).
+   end.
+   
+   method public void markStr():
+      define variable vqry as handle no-undo.
+      if available tt-tso
+      then do:
+         define variable vrowid as rowid no-undo.
+         vrowid = rowid(tt-tso).
+         { gbl/markstrn.i tt-tso rid-list-tso }
+         vqry = getQuery("tso").
+         vqry:reposition-to-rowid(vrowid).
+         vqry:get-next().
+         if available tt-tso
+         then
+            vrowid = rowid(tt-tso).
+         vqry:reposition-to-rowid(vrowid).
+      end.
+      
+   end.
+   
+   method public character  isMark():
+      return ( if lookup( string( recid(tt-tso)), rid-list-tso ) > 0 then '*' else '':U ).
+   end.
+   
+   method public void refrash():
+      define variable vqry as handle no-undo.
+      define variable vrowid as rowid no-undo.
+         
+      if available tt-tso
+      then do:
+         vrowid = rowid(tt-tso).
+         vqry = getQuery("tso").
+         vqry:reposition-to-rowid(vrowid).
+      end.
+      else
+         getQuery("tso").
+      if available tt-pump
+      then do:
+         vrowid = rowid(tt-pump).
+         vqry = getQuery("pump").
+         vqry:reposition-to-rowid(vrowid).
+      end.
+      else
+         getQuery("pump").
+   end.
+   
+   method public char getShiftStateLable():
+      return if available tt-tso then getShiftStateLable(tt-tso.ShiftState) else "".
+   end.
+   
+   method public char getShiftStateLable(iShiftState as character ):
+      return mShiftState:GetLabel(iShiftState).
+   end.
+   
+   method public char getmPumpStatusLable():
+      return if available tt-pump then getmPumpStatusLable(tt-pump.status_) else "".
+   end.
+   
+   method public char getmPumpStatusLable(iPumpState as character ):
+      return mPumpStatus:GetLabel(iPumpState).
+   end.
+      
+   method public logical AllTsoInSts(iStsList as character):
+      define buffer tt-tso for tt-tso.
+      putLog(substitute ("Проверяем статус смены ТСО/заправщике  &1",iStsList)).
+            
+      for each tt-tso where tt-tso.ShiftState ne mShiftState:DontWork:NameProp: 
+         if lookup(tt-tso.ShiftState,iStsList) eq 0
+         then do:
+            putLog(substitute ("Статуса нет в списке ТСО/заправщике &1: '&2'",tt-tso.tso-addr,tt-tso.ShiftState)).
+            
+            return no.
+         end.
+      end.
+      return yes.
+   end.
+   method public logical oneTsoInSts(iStsList as character):
+      define buffer tt-tso for tt-tso.
+      
+      for each tt-tso where tt-tso.ShiftState ne mShiftState:DontWork:NameProp:
+         if lookup(tt-tso.ShiftState,iStsList) ne 0
+         then
+            return yes.
+      end.
+      return no.
+   end.
+   
+   method public character  updCommand(icommand as character  ):
+      define buffer shift-obj         for ub.shift-obj .
+      define variable s-num as integer no-undo.
+      find last shift-obj where
+                shift-obj.obj-type   = mObjType 
+           and  shift-obj.obj-code   = mObjCode 
+           and  shift-obj.shift-date = today
+      no-error.
+      if     available shift-obj
+         and shift-obj.status_     ne {&sht-expected}
+      then  
+         s-num  = shift-obj.shift-num  + 1.
+      else do:
+         find first shift-obj where
+                   shift-obj.obj-type   = mObjType 
+              and  shift-obj.obj-code   = mObjCode 
+              and  shift-obj.shift-date = today
+              and  shift-obj.status_    = {&sht-expected}
+         no-error.
+         s-num  = (if available shift-obj then shift-obj.shift-num else 1).
+      end.
+      icommand = replace(icommand,"#NextShift#",string(s-num)).
+      return icommand.
+   end.
+end class.
