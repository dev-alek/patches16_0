+   method public void SendRec(isocetHandle as handle,
+                              iHost        as character,
+                              iPort        as integer, 
+                              iCommand     as longchar, 
+                              iTitle as character,
+                              iWaitResp as logical ):
+      run SendReqSocet in isocetHandle
+                 (iHost, 
+                  iPort, 
+                  "", 
+                  iCommand, 
+                  "http", 
+                  'getResponse').
+      if not iWaitResp
+      then
+         run Disconect in isocetHandle.
