+         {&delim-par} +
+         {&delim-par} +
+         {&delim-par} +
+         substitute("&1,&2"
+         ,"unblock"
+         ,pl-list))
+         ,input yes
+         ,input ''
+         ,input 'Разблокировка пистолетов') .
+      if not error-status:error then 
+      do:
+         if return-value begins "Для кассы" then 
+         do:
+            message return-value
+               view-as alert-box question buttons yes-no update vRetry  .
+            if vRetry ne yes  
+            then  
+               message "Сообщите в службу поддержки о неуспешной попытке разблокировки пистолетов"
+                  view-as alert-box.
+               
+         end.
