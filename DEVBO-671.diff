+procedure runBatLmCHz:
+    define input parameter iFile as character no-undo.
+    define output parameter oResult as logical no-undo.
+    
+    define variable vCommand       as character no-undo.
+    define variable vBatFile       as character no-undo.
+    define variable vOfflineAdress as character no-undo.
+    
+    vBatFile = substring(iFile, 1, r-index(iFile,".") - 1) + "1" + substring(iFile, r-index(iFile,".")). 
+    define variable vStr            as character no-undo.
+
+    define variable mask_ip    as character no-undo init "%Адрес прокси%".
+    define variable mask_port  as character no-undo init "%Порт прокси%".
+    define variable mask_login as character no-undo init "%Логин ЛМ ЧЗ%".
+    define variable mask_pass  as character no-undo init "%Пароль ЛМ ЧЗ%".
+
+    input  stream sInput  from value(iFile).
+    output stream sOutput to   value(vBatFile).
+    L_REPEAT:
+    repeat:
+        import stream sInput unformatted vStr.
+        
+        if vStr = "" or vStr begins "rem" then
+          next L_REPEAT.
+         
+        if vStr begins "rem lmchz=" then
+        do:
+          mIsError = change_gisMT_OflineAdress(entry(2,vStr,"=")).
+          run write-to-log (
+            substitute("&1Установка адреса ЛМ ЧЗ &2 - &3", 
+                       {&PREFIX_LOG}, 
+                       entry(2,vStr,"="),
+                       if mIsError 
+                          then "ошибка" 
+                          else "успешно")
+          ).
+          next L_REPEAT.  
+        end.
+        if index(vStr, "regime") > 0 and 
+           index(vStr, "/I") > 0
+        then do:
+            assign
+              vStr = replace(vStr, mask_ip,    mIp)
+              vStr = replace(vStr, mask_port,  mPort)
+              vStr = replace(vStr, mask_login, mLogin)
+              vStr = replace(vStr, mask_pass,  mPass)
+            .
+            output stream sOutput close.
+            vCommand = substitute("&1 &3 &2", "run " + vBatFile, vStr, {&ampersand}).
+            vBatFile = substring(iFile, 1, r-index(iFile,".") - 1) + "2" + substring(iFile, r-index(iFile,".")). 
+            output stream sOutput to   value(vBatFile).
+        end.
+        else do:
+          put stream sOutput unformatted vStr skip.
+        end.
+    end.
+    input  stream sInput  close.
+    output stream sOutput close.
+
+    vCommand = substitute("&1 &3 &2", vCommand, "run " + vBatFile, {&ampersand}).
+    os-command value (substitute ("&2 &1 exit" ,{&ampersand}, vCommand)).
+    mIsError = os-error <> 0.
+    os-delete value(vBatFile).
+    vBatFile = substring(iFile, 1, r-index(iFile,".") - 1) + "1" + substring(iFile, r-index(iFile,".")). 
+    os-delete value(vBatFile).
+end procedure.
