+
+/* _UIB-PREPROCESSOR-BLOCK-END */
+&ANALYZE-RESUME
+
+
+
+/* ***********************  Control Definitions  ********************** */
+
+/* Define a dialog box                                                  */
+
+/* Definitions of the field level widgets                               */
+DEFINE BUTTON b-quit AUTO-END-KEY 
+    LABEL "&Выход" 
+    SIZE 10 BY 1 TOOLTIP "Выход"
