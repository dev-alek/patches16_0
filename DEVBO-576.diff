+        then 
+            do:
+                get prev br-docs.
+                if not available c-doc then 
+                do:
+                    message
+                        "Это первый чек списка"
+                        view-as alert-box.
+                end.
+            end.
+        when "next":U
+        then 
+            do:
+                get next br-docs.
