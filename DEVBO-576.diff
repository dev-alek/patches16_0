+    SIZE 23 BY 1.
+    
+DEFINE BUTTON b-help 
+    LABEL "Помощь":L 
+    SIZE 7 BY 1.
+/* Query definitions                                                    */
+&ANALYZE-SUSPEND
+DEFINE QUERY BROWSE-2 FOR 
