+Author: Shklyar Elena
+Creation date: 26/09/17
+
+*/
+
+using Progress.Lang.*.
+block-level on error undo, throw.
+
+class ibs.th.bge.1crn.subjects.permissible-deviations inherits ibs.th.bge.1crn.subjects.asubject:
+    define override public property vss-revision    as character no-undo init "$Revision:$":U get .
+    define override public property vss-author      as character no-undo init "$Author:$":U get.
+    define override public property vss-date        as character no-undo init "$Date:$":U get.
+    define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
+    define override public property vss-archive     as character no-undo init "$Archive:$":U get. 
+
+    define property code_         as integer      no-undo get. 
+        private set.  
+    define property name_         as character    no-undo get.
+        private set.
+    define property value_        as character    no-undo get.
+        private set.
+  
+
+    define override property InitTag as character no-undo init "permissible-deviation"
+        get. 
+    
+    method override protected void SetPropProtected (inTag as char, inValue as char):
+
+        case inTag:
+            when "code" then 
+                do:
+                    assign 
+                        code_ = integer(inValue) .
+                end.
+            when "name" then 
+                do:
+                    assign 
+                        name_ = inValue .
+                end.
+            when "value" then 
+                do:
+                    assign 
+                        value_ = inValue .
+                end.
+        end case.
+    end.
+
+    method override protected void CheckData ():
+        def var v-str as char no-undo.
+    
+        assign
+            v-str = "code" 
+            when code_ = ?
+            v-str = v-str + ",name" 
+            when name_ = ?
+            v-str = v-str + ",value" 
+            when value_ = "" 
+            
+            .
+
+        v-str = trim (v-str, ",").
+        if v-str > ''
+            then 
+            undo, throw new Progress.Lang.AppError( substitute ("Теги &1 не могут иметь неопределное значение", v-str)).
+
+    end.
+
+    method override protected void ClearSub():
+        assign 
+            code_        = ?
+            name_        = ?
+            value_       = ""
+            .
+    end.
+  
+end class.
