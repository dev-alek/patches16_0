+    assign
+    EDITOR-1 = p-diff .    
+    RUN enable_UI.
+    WAIT-FOR GO OF FRAME {&FRAME-NAME} focus EDITOR-1.
+END.
+RUN disable_UI.
+
+/* _UIB-CODE-BLOCK-END */
+&ANALYZE-RESUME
+
+
+/* **********************  Internal Procedures  *********************** */
+
